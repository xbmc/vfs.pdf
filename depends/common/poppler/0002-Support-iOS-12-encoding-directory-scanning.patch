+    const auto normalize = [](const std::string &value) {
+        std::vector<std::string> parts;
+        const bool absolute = !value.empty() && value.front() == '/';
+        if (absolute) {
+            parts.emplace_back("/");
+        }
+        size_t start = 0;
+        std::string part;
+        while (start <= value.size()) {
+            const size_t end = value.find('/', start);
+            part = value.substr(start, end == std::string::npos ? end : end - start);
+            if (part == "..") {
