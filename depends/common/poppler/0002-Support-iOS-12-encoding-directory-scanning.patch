+            if (end == std::string::npos) {
+                break;
+            }
+            start = end + 1;
+        }
+        if (parts.empty() && !value.empty()) {
+            parts.emplace_back(".");
+        } else if (!parts.empty() && parts.back() != "/" && parts.back() != ".." && (part.empty() || part == "." || part == "..")) {
